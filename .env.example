# ─── Frontend ───
# Leave empty for local dev (proxied to localhost:4000)
# Set to API Gateway URL for production
VITE_API_URL=

# ─── Backend ───
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
S3_BUCKET=sketch2app-images
DYNAMODB_TABLE=sketch2app-generations

# ─── For mock mode (no AWS needed) ───
# Change the API endpoint in frontend to /api/mock-generate
# to use the hardcoded mock response
USE_MOCK=false
